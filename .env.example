# Copy this file to `.env` and fill in your own key. The scaffold makes live OpenAI calls.
# We give you a key to use for the exercise (ask if you don't have one).
OPENAI_API_KEY=sk-...

# The starting scaffold uses a single small model everywhere. You may change this.
OPENAI_MODEL=gpt-6.1-sol

# Optional: Langfuse tracing. Leave blank to run without tracing; the pipeline behaves the same.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
